# Copy to deploy/.env for docker-compose.yml (deploy/.env is git-ignored)

# IB Gateway login (the gateway container logs in with these)
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=paper

# paper-bot
PAPERBOT_STRATEGY=trend_join_long
# PAPERBOT_IB_PORT=4003            # live relay port; also set "mode": "live" in config.json
# PAPERBOT_LIVE_CONFIRM=U0000000   # required for live: your live account id

# Notifications (optional): same as the project .env
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_URL=

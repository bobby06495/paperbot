{
 "strategy_id": "trend_join_long",
 "rules": {
  "label": "Trend Join Long",
  "summary": "Intraday stock breakouts - large-cap momentum",
  "order_ref": "paperbot",
  "state_dir": ".",
  "modes": [
   "continuous",
   "scheduled"
  ],
  "timeframe": "5m",
  "holding": "intraday",
  "universe": {
   "source": "watchlist",
   "fallback_file": "universe.txt",
   "index": "S&P 500"
  },
  "time_filter": {
   "earliest_entry_et": "10:05",
   "latest_entry_et": "15:30",
   "force_close_et": "15:51"
  },
  "entry": [
   {
    "type": "min_prior_close",
    "min_usd": 3.0
   },
   {
    "type": "prior_close_above_sma",
    "label": "D2",
    "period": 200
   },
   {
    "type": "min_price",
    "min_usd": 3.0
   },
   {
    "type": "min_gap_pct",
    "label": "D3",
    "min_pct": 4.0
   },
   {
    "type": "above_prior_day_high",
    "label": "D1"
   },
   {
    "type": "above_premarket_high",
    "label": "I1"
   },
   {
    "type": "new_high_of_day",
    "label": "I2"
   },
   {
    "type": "min_rvol",
    "label": "I3",
    "min": 2.0,
    "lookback_days": 14
   }
  ],
  "stop": {
   "type": "low_of_day_minus_pct",
   "pct": 1.0
  },
  "manage": [
   {
    "type": "partial_profit",
    "at_R": 0.75,
    "fraction": 0.3333
   },
   {
    "type": "breakeven",
    "at_R": 1.0
   },
   {
    "type": "trail_swing_low",
    "left": 2,
    "right": 2
   }
  ],
  "exit": [
   {
    "type": "force_close"
   }
  ],
  "entry_reason": "trend join: gap {gap:.1f}%, rvol {rvol:.1f}, stop {stop:.2f}",
  "risk": {
   "max_risk_per_trade_pct": 1.0,
   "max_position_size_pct_of_portfolio": 10,
   "max_concurrent_positions": 5,
   "max_commission_pct_of_risk": 1.0,
   "max_drawdown_usd": 6000,
   "max_quantity_per_order": 500,
   "max_order_value": 30000.0,
   "max_orders_per_day": 5,
   "max_open_orders": 2,
   "max_daily_loss": 2000.0
  }
 },
 "production_rules_sha256": "a5a6792937c6f08e6797740c5211b443c30c853c59bf8a85f39aa71d26f703c6",
 "backtest": {
  "currency": "USD",
  "starting_capital": 1000000.0,
  "provider": "ibkr",
  "fallback_provider": "yfinance",
  "lookback_calendar_days": 120,
  "daily_warmup_calendar_days": 420,
  "symbols": [],
  "max_watchlist": 20,
  "benchmark_symbol": "SPY",
  "execution": {
   "half_spread_bps": 2.0,
   "slippage_bps": 2.0,
   "participation_rate": 0.1,
   "buying_power_multiplier": 1.0,
   "ambiguous_bar_policy": "stop_first",
   "decision_delay_seconds": 3,
   "reset_drawdown_breaker_next_day": false
  },
  "validation": {
   "in_sample": 0.6,
   "validation": 0.2,
   "out_of_sample": 0.2,
   "walk_forward_folds": 3,
   "min_trades_for_assessment": 30,
   "bootstrap_samples": 2000,
   "bootstrap_seed": 7
  },
  "ibkr": {
   "client_id_offset": 3,
   "request_pause_seconds": 0.5,
   "timeout_seconds": 60
  },
  "retention": {
   "keep_last_runs_per_strategy": 50
  },
  "schedule": {
   "enabled": false,
   "note": "Manual only. Run `paperbot-backtest all` yourself; no scheduled task is registered."
  }
 },
 "limits": {
  "allowed_symbols": [
   "*"
  ],
  "limit_orders_only": true
 },
 "experiment_changes": {
  "entry.3.min_pct": 4.0
 }
}
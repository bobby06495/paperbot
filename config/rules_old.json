{
  "default_strategy": "trend_join_long",
  "strategies": {
    "trend_join_long": {
      "label": "Trend Join Long",
      "summary": "Intraday stock breakouts - large-cap momentum",
      "order_ref": "paperbot",
      "state_dir": ".",
      "modes": ["continuous", "scheduled"],
      "timeframe": "5m",
      "holding": "intraday",
      "universe": {"source": "watchlist", "fallback_file": "universe.txt", "index": "S&P 500"},
      "time_filter": {
        "earliest_entry_et": "10:05",
        "latest_entry_et": "15:30",
        "force_close_et": "15:51"
      },
      "entry": [
        {"type": "min_prior_close", "min_usd": 3.0},
        {"type": "prior_close_above_sma", "label": "D2", "period": 200},
        {"type": "min_price", "min_usd": 3.0},
        {"type": "min_gap_pct", "label": "D3", "min_pct": 3.0},
        {"type": "above_prior_day_high", "label": "D1"},
        {"type": "above_premarket_high", "label": "I1"},
        {"type": "new_high_of_day", "label": "I2"},
        {"type": "min_rvol", "label": "I3", "min": 2.0, "lookback_days": 14}
      ],
      "stop": {"type": "low_of_day_minus_pct", "pct": 1.0},
      "manage": [
        {"type": "partial_profit", "at_R": 0.75, "fraction": 0.3333},
        {"type": "breakeven", "at_R": 1.0},
        {"type": "trail_swing_low", "left": 2, "right": 2}
      ],
      "exit": [{"type": "force_close"}],
      "entry_reason": "trend join: gap {gap:.1f}%, rvol {rvol:.1f}, stop {stop:.2f}",
      "risk": {
        "max_risk_per_trade_pct": 1.0,
        "max_position_size_pct_of_portfolio": 10,
        "max_concurrent_positions": 5,
        "max_commission_pct_of_risk": 1.0,
        "max_drawdown_usd": 6000,
        "max_quantity_per_order": 500,
        "max_order_value": 30000.0,
        "max_orders_per_day": 5,
        "max_open_orders": 2,
        "max_daily_loss": 2000.0
      }
    },
    "macro_swing_etf": {
      "label": "Macro Swing ETF",
      "summary": "Multi-day sector pullbacks - holds positions overnight",
      "modes": ["continuous", "scheduled"],
      "timeframe": "1d",
      "holding": "multi_day",
      "universe": {"symbols": ["XLK", "XLF", "XLE", "XLV", "XLI", "XLY", "XLP", "XLU", "XLB", "XLRE", "XLC"]},
      "time_filter": {
        "earliest_entry_et": "15:45",
        "latest_entry_et": "15:55",
        "force_close_et": null
      },
      "entry": [
        {"type": "close_above_sma", "label": "T1", "period": 200},
        {"type": "rsi_below", "label": "P1", "period": 2, "max": 10.0}
      ],
      "stop": {"type": "atr_multiple", "period": 14, "multiple": 2.0},
      "manage": [],
      "exit": [
        {"type": "close_above_sma", "period": 5, "at_et": "15:50"},
        {"type": "time_stop", "days": 10, "at_et": "15:50"}
      ],
      "entry_reason": "macro swing: RSI(2) pullback above SMA200, stop {stop:.2f}",
      "risk": {
        "max_risk_per_trade_pct": 1.0,
        "max_position_size_pct_of_portfolio": 10,
        "max_concurrent_positions": 3,
        "max_commission_pct_of_risk": 1.0,
        "max_drawdown_usd": 6000,
        "max_quantity_per_order": 1000,
        "max_order_value": 30000.0,
        "max_orders_per_day": 5,
        "max_open_orders": 3,
        "max_daily_loss": 2000.0
      }
    },
    "equity_mean_reversion": {
      "label": "Equities Mean Reversion",
      "summary": "Intraday index ETF scalps on VWAP deviations",
      "modes": ["continuous"],
      "timeframe": "1m",
      "holding": "intraday",
      "universe": {"symbols": ["SPY", "QQQ", "IWM"]},
      "time_filter": {
        "earliest_entry_et": "10:00",
        "latest_entry_et": "15:30",
        "force_close_et": "15:50"
      },
      "max_entries_per_symbol_per_day": 3,
      "entry": [
        {"type": "below_vwap_sigma", "label": "V1", "sigma": 2.0}
      ],
      "stop": {"type": "sigma_below_entry", "sigma": 1.0},
      "manage": [],
      "exit": [
        {"type": "target_vwap"},
        {"type": "time_stop", "minutes": 30},
        {"type": "force_close"}
      ],
      "entry_reason": "mean reversion: VWAP stretch, stop {stop:.2f}",
      "risk": {
        "max_risk_per_trade_pct": 0.5,
        "max_position_size_pct_of_portfolio": 10,
        "max_concurrent_positions": 2,
        "max_commission_pct_of_risk": 5.0,
        "max_drawdown_usd": 6000,
        "max_quantity_per_order": 500,
        "max_order_value": 30000.0,
        "max_orders_per_day": 5,
        "max_open_orders": 2,
        "max_daily_loss": 2000.0
      }
    }
  }
}
